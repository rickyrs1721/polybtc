# Copia a .env y rellena localmente. NUNCA pongas valores reales en este archivo.
# .env está en .gitignore desde el commit 1 (§0). Usa una wallet nueva y dedicada,
# fondeada solo con el capital de trading — nunca la wallet principal.

# --- Credenciales (solo en .env local; jamás en logs, chats ni commits) ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Dirección pública de la wallet de trading y tipo de firma.
# Decisión abierta en §8: Deposit Wallet (sig type 3, envoltura ERC-7739) vs Proxy (sig type 1).
# Resuélvela antes de escribir execution/ — no es refactorizable a mitad.
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=

# --- Entorno ---
POLYBTC_ENV=paper          # paper | live
POLYBTC_LOG_LEVEL=INFO

# --- Límites de riesgo (§5.2; los valores por defecto viven en config.py) ---
POLYBTC_MAX_NOTIONAL_PER_POSITION_USD=
POLYBTC_MAX_TOTAL_EXPOSURE_USD=
POLYBTC_MAX_DAILY_LOSS_USD=
