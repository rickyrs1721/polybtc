# Configuración del grabador en el VPS. Se copia a /etc/polybtc/polybtc.env.
#
# NO pongas secretos aquí. La Fase 0 son feeds públicos sin credenciales, y la llave
# privada del Sprint 7 vive fuera del repo y fuera de este archivo (§0). Cuando llegue ese
# momento habrá que decidir explícitamente si la llave vive en esta máquina o la firma se
# queda en otro sitio — no es una decisión que se herede por descuido.

# Los datos viven FUERA del repo, para que un `git pull` no pueda rozarlos.
POLYBTC_DATA_DIR=/var/lib/polybtc/data
POLYBTC_STATE_DB_PATH=/var/lib/polybtc/data/state.db

# El dashboard escucha solo en local. Se mira por túnel SSH:
#     ssh -N -L 8000:127.0.0.1:8000 usuario@vps
# Abrirlo al mundo sería regalar el estado interno del sistema sin autenticación alguna.
POLYBTC_DASHBOARD_HOST=127.0.0.1
POLYBTC_DASHBOARD_PORT=8000
